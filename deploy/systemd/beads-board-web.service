[Unit]
Description=Beads Board web endpoint
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=%h/.local/lib/beads-board/current
EnvironmentFile=%h/.config/beads-board/runtime.env
EnvironmentFile=%h/.config/beads-board/web.env
Environment=BOARD_ROLE=web PHX_SERVER=true RELEASE_DISTRIBUTION=none
Environment=RELEASE_TMP=%t/beads-board-web
UnsetEnvironment=FLUXON_LICENSE_KEY FLUXON_KEY_FINGERPRINT
ExecStart=%h/.local/lib/beads-board/current/bin/board start
Restart=always
RestartSec=5s
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=90s
RuntimeDirectory=beads-board-web
RuntimeDirectoryMode=0700
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=beads-board-web

[Install]
WantedBy=default.target
