# systemd EnvironmentFile syntax: literal values, no export or shell expansion.
# Replace placeholders before starting either unit. Keep this file untracked.
DATABASE_URL=ecto://USER:PASSWORD@127.0.0.1/foreman
PATH=/absolute/directory/containing/bd:/usr/local/bin:/usr/bin:/bin
PORT=4747
POOL_SIZE=10
# Optional absolute paths (defaults are the user's config directory and ~/dev):
# FOREMAN_CONFIG_DIR=/absolute/path/to/config-directory
# FOREMAN_DISCOVERY_ROOT=/absolute/path/to/repos
# Agent API bearer token: an absolute path to a mode-600 file you create in your secrets directory.
FOREMAN_TOKEN_FILE=/absolute/path/to/token-file
