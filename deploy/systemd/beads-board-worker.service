[Unit]
Description=Beads Board queues, reader, scheduler and config watcher
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=%h/.local/lib/beads-board/current
EnvironmentFile=%h/.config/beads-board/runtime.env
Environment=BOARD_ROLE=worker RELEASE_DISTRIBUTION=none
Environment=RELEASE_TMP=%t/beads-board-worker
UnsetEnvironment=SECRET_KEY_BASE PHX_SERVER FLUXON_LICENSE_KEY FLUXON_KEY_FINGERPRINT
ExecStart=%h/.local/lib/beads-board/current/bin/board start
Restart=always
RestartSec=5s
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=90s
RuntimeDirectory=beads-board-worker
RuntimeDirectoryMode=0700
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=beads-board-worker

[Install]
WantedBy=default.target
